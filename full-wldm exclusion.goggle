! ===========================================================
! URL / PAGE-TYPE FILTERS
! Broad suffix filters retained from the source list.
*.wiki/*$discard
*.gov/*$discard
*.fr/*$discard

! Common document/archive file results
*.pdf$discard
*.doc$discard
*.docx$discard
*.xls$discard
*.xlsx$discard
*.ppt$discard
*.pptx$discard
*.csv$discard
*.zip$discard

! Forum, community, discussion, tag, category, thread and profile paths
/forum/$discard
/forums/$discard
/community/$discard
/communities/$discard
/discussion/$discard
/discussions/$discard
/tag/$discard
/tags/$discard
/category/$discard
/categories/$discard
/thread/$discard
/threads/$discard
/libri/$discard
/libro/$discard
/product/$discard
/products/$discard
/user/$discard
/users/$discard
/profile/$discard
/profiles/$discard
/member/$discard
/members/$discard
/topic/$discard
/topics/$discard
/book/$discard
/books/$discard
/collection/$discard
/collections/$discard
/play/$discard
/download/$discard
/downloads/$discard

! Search/internal search pages
/search/$discard
/search?*$discard
*?search=*$discard
*?q=*$discard

! Broad language / index-page filters retained from the original
/fr/$discard
/blogs$discard
/news$discard

! Wildcard brand-family blocks retained from the original list
*amazon.*$discard
*github.*$discard
*ebay.*$discard
*bbc.*$discard

! ===========================================================
! CONTENT-PAGE BOOSTS
! These do not override any matching discard rule.
*.html$boost=1
/blog/*$boost=1
/blogs/*$boost=1
/news/*$boost=1
/article/*$boost=1
