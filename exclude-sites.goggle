! name: exclusion-wldm
! description: Excludes my unwanted domains from Brave Search
! public: false
! author: MSH

! Block .wiki domains
.wiki^$discard
.gov^$discard
.pdf^$discard
.doc^$discard
.docx^$discard
.xls^$discard
.xlsx^$discard
.ppt^$discard
.pptx^$discard
.csv^$discard
.zip^$discard
! communities, tags, products, forum pages
|https://forum.^$discard
|https://forums.^$discard
|https://community.^$discard
|https://communities.^$discard
/forum/$discard
/forums/$discard
/community/$discard
/communities/$discard
/discussion/$discard
/discussions/$discard
/tag/$discard
/tags/$discard
/category/$discard
/categories/$discard
/thread/$discard
/threads/$discard
/product/$discard
/products/$discard
/user/$discard
/users/$discard
/profile/$discard
/profiles/$discard
/member/$discard
/members/$discard
/topic/$discard
/topics/$discard
/book/$discard
/collection/$discard
/collections/$discard
/books/$discard
/play/$discard
/download/$discard
/downloads/$discard
/fr/$discard
.fr^$discard

! ============================================================
! BLOCK COMMON SEARCH / INTERNAL SEARCH PAGES
! ============================================================

/search/$discard
/search?*$discard
?search=$discard
?q=$discard

/blogs$discard
/news$discard
! ============================================================
! boost pages
! ============================================================
.html^$boost=1
/blog/*$boost=1
/blogs/*$boost=1
/news/*$boost=1
/article/*$boost=1

$discard,site=youtube.com
$discard,site=youtu.be
